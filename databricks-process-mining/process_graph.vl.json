{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Soll-Ist-Prozessgraph eines Data-Manager-Prozesses. Layout, Konformität und Kontrollschritte kommen aus 04_ds_process_graph.sql.",
  "width": "container",
  "height": "container",
  "data": {
    "name": "databricks_query"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "symbolStrokeWidth": 2,
      "labelLimit": 260
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.row_type === 'frame'"
        }
      ],
      "mark": {
        "type": "point",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "reverse": true,
            "nice": false,
            "zero": false
          },
          "axis": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.row_type === 'edge'"
        }
      ],
      "mark": {
        "type": "line",
        "strokeJoin": "round",
        "strokeCap": "butt"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "reverse": true,
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "detail": {
          "field": "id",
          "type": "nominal"
        },
        "order": {
          "field": "seq",
          "type": "quantitative"
        },
        "strokeWidth": {
          "field": "cases",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              1,
              7
            ]
          },
          "legend": null
        },
        "color": {
          "field": "conformance",
          "type": "nominal",
          "scale": {
            "domain": [
              "soll",
              "abweichung",
              "kontrolle_umgangen",
              "latent"
            ],
            "range": [
              "#8f8e88",
              "#eb6834",
              "#d03b3b",
              "#a3a29c"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-left",
            "direction": "vertical",
            "symbolType": "stroke",
            "labelExpr": "datum.label === 'soll' ? 'Laut Soll-Prozess' : datum.label === 'abweichung' ? 'Abweichung' : datum.label === 'kontrolle_umgangen' ? 'Kontrolle umgangen' : 'System erlaubt, ungenutzt'"
          }
        },
        "strokeDash": {
          "field": "conformance",
          "type": "nominal",
          "scale": {
            "domain": [
              "soll",
              "abweichung",
              "kontrolle_umgangen",
              "latent"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                6,
                4
              ],
              [
                6,
                4
              ],
              [
                2,
                3
              ]
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-left",
            "direction": "vertical",
            "symbolType": "stroke",
            "labelExpr": "datum.label === 'soll' ? 'Laut Soll-Prozess' : datum.label === 'abweichung' ? 'Abweichung' : datum.label === 'kontrolle_umgangen' ? 'Kontrolle umgangen' : 'System erlaubt, ungenutzt'"
          }
        },
        "tooltip": [
          {
            "field": "src",
            "type": "nominal",
            "title": "Von"
          },
          {
            "field": "tgt",
            "type": "nominal",
            "title": "Nach"
          },
          {
            "field": "system_status",
            "type": "nominal",
            "title": "System"
          },
          {
            "field": "cases",
            "type": "quantitative",
            "title": "Übergänge",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.row_type === 'arrow'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "reverse": true,
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "shape": {
          "field": "shape",
          "type": "nominal",
          "scale": null
        },
        "size": {
          "field": "cases",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              45,
              190
            ]
          },
          "legend": null
        },
        "color": {
          "field": "conformance",
          "type": "nominal",
          "scale": {
            "domain": [
              "soll",
              "abweichung",
              "kontrolle_umgangen",
              "latent"
            ],
            "range": [
              "#8f8e88",
              "#eb6834",
              "#d03b3b",
              "#a3a29c"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.row_type === 'label' && datum.cases > 0"
        },
        {
          "calculate": "replace(format(datum.cases, ','), ',', '.')",
          "as": "cases_txt"
        },
        {
          "calculate": "max(0, (8 + 6 * length(datum.cases_txt)) / 14 - 1)",
          "as": "b"
        },
        {
          "calculate": "'M' + (-datum.b) + ',-1H' + datum.b + 'A1,1,0,0,1,' + datum.b + ',1H' + (-datum.b) + 'A1,1,0,0,1,' + (-datum.b) + ',-1Z'",
          "as": "pill"
        },
        {
          "calculate": "datum.conformance === 'soll' ? 'erlaubt' : datum.finding_type",
          "as": "status"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true,
            "fill": "#ffffff",
            "strokeWidth": 1,
            "opacity": 1,
            "size": 196
          },
          "encoding": {
            "shape": {
              "field": "pill",
              "type": "nominal",
              "scale": null
            },
            "stroke": {
              "field": "conformance",
              "type": "nominal",
              "scale": {
                "domain": [
                  "soll",
                  "abweichung",
                  "kontrolle_umgangen",
                  "latent"
                ],
                "range": [
                  "#c3c2b7",
                  "#eb6834",
                  "#d03b3b",
                  "#a3a29c"
                ]
              }
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "color": "#52514e"
          },
          "encoding": {
            "text": {
              "field": "cases_txt",
              "type": "nominal"
            }
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "reverse": true,
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "tooltip": [
          {
            "field": "src",
            "type": "nominal",
            "title": "Von"
          },
          {
            "field": "tgt",
            "type": "nominal",
            "title": "Nach"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Befund"
          },
          {
            "field": "system_status",
            "type": "nominal",
            "title": "System"
          },
          {
            "field": "cases",
            "type": "quantitative",
            "title": "Übergänge",
            "format": ","
          },
          {
            "field": "median_wait_h",
            "type": "quantitative",
            "title": "Median-Wartezeit (h)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "(datum.row_type === 'node' && datum.node_kind === 'activity') || datum.row_type === 'frame'"
        },
        {
          "calculate": "datum.x - (datum.w || 0) / 2",
          "as": "x_lo"
        },
        {
          "calculate": "datum.x + (datum.w || 0) / 2",
          "as": "x_hi"
        },
        {
          "calculate": "datum.y - (datum.h || 0) / 2",
          "as": "y_lo"
        },
        {
          "calculate": "datum.y + (datum.h || 0) / 2",
          "as": "y_hi"
        },
        {
          "calculate": "datum.x - (datum.w || 0) / 2 + 8",
          "as": "x_txt"
        },
        {
          "calculate": "replace(format(datum.cases, ','), ',', '.')",
          "as": "cases_txt"
        },
        {
          "calculate": "datum.conformance !== 'soll' ? 'Nicht im Soll-Prozess' : datum.is_control === 1 ? 'Kontrollschritt im Soll-Prozess' : 'Teil des Soll-Prozesses'",
          "as": "status"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.conformance === 'soll' && datum.row_type !== 'frame'"
            }
          ],
          "mark": {
            "type": "rect",
            "cornerRadius": 3,
            "strokeWidth": 1,
            "stroke": "#6da7ec"
          },
          "encoding": {
            "x": {
              "field": "x_lo",
              "type": "quantitative",
              "scale": {
                "nice": false,
                "zero": false
              },
              "axis": null
            },
            "x2": {
              "field": "x_hi"
            },
            "y": {
              "field": "y_lo",
              "type": "quantitative",
              "scale": {
                "reverse": true,
                "nice": false,
                "zero": false
              },
              "axis": null
            },
            "y2": {
              "field": "y_hi"
            },
            "fill": {
              "field": "cases",
              "type": "quantitative",
              "scale": {
                "range": [
                  "#f4f8fd",
                  "#86b6ef"
                ]
              },
              "legend": null
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.conformance === 'abweichung' || datum.row_type === 'frame'"
            }
          ],
          "mark": {
            "type": "rect",
            "cornerRadius": 3,
            "strokeWidth": 1.5,
            "stroke": "#eb6834",
            "strokeDash": [
              4,
              3
            ],
            "fill": "#fdf0ea"
          },
          "encoding": {
            "x": {
              "field": "x_lo",
              "type": "quantitative",
              "scale": {
                "nice": false,
                "zero": false
              },
              "axis": null
            },
            "x2": {
              "field": "x_hi"
            },
            "y": {
              "field": "y_lo",
              "type": "quantitative",
              "scale": {
                "reverse": true,
                "nice": false,
                "zero": false
              },
              "axis": null
            },
            "y2": {
              "field": "y_hi"
            },
            "strokeOpacity": {
              "condition": {
                "test": "datum.row_type === 'frame'",
                "value": 0
              },
              "value": 1
            },
            "fillOpacity": {
              "condition": {
                "test": "datum.row_type === 'frame'",
                "value": 0
              },
              "value": 1
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dy": -7,
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#0b0b0b"
          },
          "encoding": {
            "text": {
              "field": "id",
              "type": "nominal"
            }
          },
          "transform": [
            {
              "filter": "datum.row_type !== 'frame'"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dy": 8,
            "fontSize": 10,
            "color": "#52514e"
          },
          "encoding": {
            "text": {
              "field": "cases_txt",
              "type": "nominal"
            }
          },
          "transform": [
            {
              "filter": "datum.row_type !== 'frame'"
            }
          ]
        },
        {
          "transform": [
            {
              "filter": "datum.is_control === 1 && datum.row_type !== 'frame'"
            },
            {
              "calculate": "datum.x + datum.w / 2 - 8",
              "as": "x_tag"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dy": 8,
            "fontSize": 9,
            "fontWeight": 600,
            "color": "#52514e",
            "text": "◆ KONTROLLE"
          },
          "encoding": {
            "x": {
              "field": "x_tag",
              "type": "quantitative",
              "scale": {
                "nice": false,
                "zero": false
              },
              "axis": null
            }
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "x_txt",
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "reverse": true,
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "tooltip": [
          {
            "field": "id",
            "type": "nominal",
            "title": "Aktivität"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "cases",
            "type": "quantitative",
            "title": "Vorkommen",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.row_type === 'node' && datum.node_kind !== 'activity'"
        },
        {
          "calculate": "datum.node_kind === 'start' ? 'triangle-right' : 'square'",
          "as": "symbol"
        },
        {
          "calculate": "datum.node_kind === 'start' ? 'Start' : 'Ende'",
          "as": "node_label"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "point",
            "shape": "circle",
            "filled": true,
            "fill": "#ffffff",
            "stroke": "#8f8e88",
            "strokeWidth": 2,
            "opacity": 1,
            "size": 420
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "color": "#52514e",
            "opacity": 1,
            "size": 60
          },
          "encoding": {
            "shape": {
              "field": "symbol",
              "type": "nominal",
              "scale": null
            }
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "reverse": true,
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "tooltip": [
          {
            "field": "node_label",
            "type": "nominal",
            "title": "Knoten"
          },
          {
            "field": "cases",
            "type": "quantitative",
            "title": "Fälle",
            "format": ","
          }
        ]
      }
    }
  ]
}