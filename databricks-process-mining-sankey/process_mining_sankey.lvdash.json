{
  "datasets": [
    {
      "name": "sankey_paths",
      "displayName": "Sankey – Prozesspfade",
      "queryLines": [
        "WITH traces AS (\n",
        "  SELECT\n",
        "    case_id,\n",
        "    region,\n",
        "    transform(array_sort(collect_list(struct(event_ts, step_no, activity))), x -> x.activity) AS trace,\n",
        "    timestampdiff(HOUR, min(event_ts), max(event_ts)) / 24.0 AS throughput_days\n",
        "  FROM main.process_mining.event_log\n",
        "  GROUP BY case_id, region\n",
        ")\n",
        "SELECT\n",
        "  region,\n",
        "  try_element_at(trace, 1) AS step_1,\n",
        "  try_element_at(trace, 2) AS step_2,\n",
        "  try_element_at(trace, 3) AS step_3,\n",
        "  try_element_at(trace, 4) AS step_4,\n",
        "  try_element_at(trace, 5) AS step_5,\n",
        "  try_element_at(trace, 6) AS step_6,\n",
        "  try_element_at(trace, 7) AS step_7,\n",
        "  array_join(trace, ' → ')                 AS variant,\n",
        "  COUNT(*)                                 AS cases,\n",
        "  ROUND(AVG(throughput_days), 1)           AS avg_throughput_days\n",
        "FROM traces\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "case_kpis",
      "displayName": "KPIs je Fall",
      "queryLines": [
        "WITH traces AS (\n",
        "  SELECT\n",
        "    case_id, region,\n",
        "    min(event_ts) AS case_start,\n",
        "    array_join(transform(array_sort(collect_list(struct(event_ts, step_no, activity))), x -> x.activity), '|') AS variant,\n",
        "    timestampdiff(HOUR, min(event_ts), max(event_ts)) / 24.0 AS throughput_days,\n",
        "    max(CASE WHEN activity = 'Storniert' THEN 1 ELSE 0 END) AS is_cancelled,\n",
        "    max(CASE WHEN activity IN ('Mahnung','Preisänderung','Gutschrift') THEN 1 ELSE 0 END) AS has_rework\n",
        "  FROM main.process_mining.event_log\n",
        "  GROUP BY case_id, region\n",
        ")\n",
        "SELECT region, case_id, case_start, variant, throughput_days, is_cancelled, has_rework\n",
        "FROM traces\n"
      ]
    },
    {
      "name": "transitions",
      "displayName": "Übergänge (Directly-Follows)",
      "queryLines": [
        "WITH t AS (\n",
        "  SELECT\n",
        "    case_id,\n",
        "    region,\n",
        "    activity AS from_activity,\n",
        "    event_ts,\n",
        "    LEAD(activity) OVER (PARTITION BY case_id ORDER BY event_ts, step_no) AS to_activity,\n",
        "    LEAD(event_ts) OVER (PARTITION BY case_id ORDER BY event_ts, step_no) AS next_ts\n",
        "  FROM main.process_mining.event_log\n",
        ")\n",
        "SELECT\n",
        "  case_id,\n",
        "  region,\n",
        "  from_activity,\n",
        "  COALESCE(to_activity, '■ Ende')               AS to_activity,\n",
        "  timestampdiff(MINUTE, event_ts, next_ts) / 60.0 AS wait_h   -- NULL beim Ende\n",
        "FROM t\n"
      ]
    }
  ],
